---
interface Props {
  /** Height of the mark in px. The wordmark scales with it. */
  size?: number;
  /** Mark only, no wordmark. */
  markOnly?: boolean;
  class?: string;
}

const { size = 22, markOnly = false, class: className = '' } = Astro.props;
// Traced from docs/brand/app-icon-1200.png. Single path, currentColor,
// so the same file works on light and dark backgrounds.
const width = Math.round((848 / 628) * size);
---

<span class={`inline-flex items-center gap-2.5 ${className}`}>
  <svg
    viewBox="176 286 848 628"
    width={width}
    height={size}
    fill="none"
    aria-hidden={markOnly ? 'false' : 'true'}
    role={markOnly ? 'img' : undefined}
    aria-label={markOnly ? 'Stockly' : undefined}
  >
    <path
      fill="currentColor"
      d="M 667.500 286.992 C 544.565 291.690, 471.310 310.423, 412.341 352.244 C 349.927 396.508, 308.163 470.425, 283.090 581 C 279.429 597.146, 273 630.193, 273 632.865 C 273 633.720, 292.286 633.947, 348.736 633.756 L 424.472 633.500 428.057 620 C 439.410 577.250, 449.752 561.531, 474.500 549.406 C 498.766 537.518, 521.271 536.370, 698.500 537.972 C 835.717 539.212, 855.141 538.883, 875.386 534.976 C 927.852 524.851, 967.962 493.323, 993.037 442.500 C 1011.472 405.133, 1021.267 362.009, 1022.707 311.870 L 1023.300 291.240 982.400 290.576 C 959.905 290.211, 911.800 289.261, 875.500 288.465 C 790.277 286.596, 695.428 285.925, 667.500 286.992 M 775.630 566.790 C 775.361 567.225, 773.953 572.267, 772.502 577.994 C 761.572 621.113, 750.375 638.407, 725.500 650.594 C 701.210 662.493, 678.883 663.627, 500.500 662.012 C 362.391 660.762, 345.160 661.059, 324.494 665.047 C 272.122 675.154, 232.031 706.690, 206.963 757.500 C 188.528 794.867, 178.733 837.991, 177.293 888.130 L 176.700 908.760 217.600 909.421 C 240.095 909.784, 288.650 910.728, 325.500 911.518 C 495.184 915.154, 551.215 914.352, 610.500 907.440 C 699.241 897.094, 761.210 873.215, 808.716 831.059 C 859.297 786.174, 894.767 716.653, 916.910 619 C 920.567 602.872, 927 569.808, 927 567.141 C 927 565.804, 776.455 565.455, 775.630 566.790"
    ></path>
  </svg>
  {
    !markOnly && (
      <span
        class="font-semibold tracking-[-0.035em]"
        style={`font-size:${Math.round(size * 1.12)}px`}
      >
        Stockly
      </span>
    )
  }
</span>
