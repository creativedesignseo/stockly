---
// Mirrors the two minimum rules the app stores per shop: the opening-order
// gate (fpqMode / fpqAmount) and the recurring one (postQualificationMode,
// postQualificationMinAmount, postQualificationMOQ + combined logic).
---

<div class="rounded-card overflow-hidden bg-white text-[#303030] ring-1 ring-[#e4e4e1]">
  <div class="border-b border-[#ececea] px-4 py-3">
    <p class="text-[0.8125rem] font-semibold">Order minimums</p>
  </div>

  <div class="border-b border-[#f2f2f0] px-4 py-4">
    <div class="flex items-center justify-between gap-3">
      <p class="text-[0.8125rem] font-medium text-[#303030]">First order</p>
      <span
        class="flex items-center gap-1.5 rounded-full bg-[#e6f5ec] px-2 py-0.5 text-[0.6875rem] font-medium text-[#15883b]"
      >
        <span class="inline-block h-1.5 w-1.5 rounded-full bg-[#15883b]"></span>On
      </span>
    </div>
    <p class="mt-1 text-[0.75rem] text-[#616161]">
      A buyer becomes a full wholesale account after one order of
    </p>
    <div
      class="mt-2.5 inline-flex items-center rounded-md px-2.5 py-1.5 text-[0.8125rem] font-semibold text-[#303030] ring-1 ring-[#d9d9d6] tabular-nums"
    >
      $300.00
    </div>
  </div>

  <div class="px-4 py-4">
    <div class="flex items-center justify-between gap-3">
      <p class="text-[0.8125rem] font-medium text-[#303030]">Every order after that</p>
      <span
        class="flex items-center gap-1.5 rounded-full bg-[#e6f5ec] px-2 py-0.5 text-[0.6875rem] font-medium text-[#15883b]"
      >
        <span class="inline-block h-1.5 w-1.5 rounded-full bg-[#15883b]"></span>On
      </span>
    </div>
    <div class="mt-2.5 flex flex-wrap items-center gap-2">
      <span
        class="rounded-md px-2.5 py-1.5 text-[0.8125rem] font-semibold text-[#303030] ring-1 ring-[#d9d9d6] tabular-nums"
        >$100.00</span
      >
      <span class="rounded bg-[#0b0b0b] px-2 py-1 text-[0.6875rem] font-semibold text-white"
        >AND</span
      >
      <span
        class="rounded-md px-2.5 py-1.5 text-[0.8125rem] font-semibold text-[#303030] ring-1 ring-[#d9d9d6] tabular-nums"
        >12 units</span
      >
    </div>
    <p class="mt-2.5 text-[0.75rem] text-[#616161]">
      Switch to <span class="font-medium text-[#303030]">OR</span> if either one should be enough.
    </p>
  </div>
</div>
