---
import Logo from './Logo.astro';

const year = new Date().getFullYear();
---

<footer class="on-ink bg-ink text-white">
  <div class="shell py-14">
    <div class="flex flex-col gap-10 md:flex-row md:items-start md:justify-between">
      <div class="max-w-xs">
        <Logo size={22} />
        <p class="mt-4 text-[0.875rem] leading-relaxed text-white/50">
          Wholesale tooling for Shopify stores — applications, volume pricing and order
          minimums enforced at checkout.
        </p>
      </div>

      <nav class="grid grid-cols-2 gap-x-12 gap-y-8 sm:grid-cols-3" aria-label="Footer">
        <div>
          <h2 class="text-[0.75rem] font-semibold tracking-wider text-white/55 uppercase">
            Product
          </h2>
          <ul class="mt-3 space-y-2.5 text-[0.875rem]">
            <li><a href="/#features" class="text-white/70 hover:text-white">Features</a></li>
            <li><a href="/#how" class="text-white/70 hover:text-white">How it works</a></li>
            <li><a href="/#pricing" class="text-white/70 hover:text-white">Pricing</a></li>
            <li><a href="/#faq" class="text-white/70 hover:text-white">FAQ</a></li>
          </ul>
        </div>
        <div>
          <h2 class="text-[0.75rem] font-semibold tracking-wider text-white/55 uppercase">
            Legal
          </h2>
          <ul class="mt-3 space-y-2.5 text-[0.875rem]">
            <li><a href="/privacy" class="text-white/70 hover:text-white">Privacy</a></li>
            <li><a href="/terms" class="text-white/70 hover:text-white">Terms</a></li>
          </ul>
        </div>
        <div>
          <h2 class="text-[0.75rem] font-semibold tracking-wider text-white/55 uppercase">
            Contact
          </h2>
          <ul class="mt-3 space-y-2.5 text-[0.875rem]">
            <li>
              <a href="mailto:hello@stocklygo.site" class="text-white/70 hover:text-white"
                >hello@stocklygo.site</a
              >
            </li>
          </ul>
        </div>
      </nav>
    </div>

    <div
      class="mt-12 flex flex-col gap-2 border-t border-white/10 pt-6 text-[0.8125rem] text-white/55 sm:flex-row sm:items-center sm:justify-between"
    >
      <p>© {year} Stockly. Built in Barcelona.</p>
      <p>Not affiliated with or endorsed by Shopify Inc.</p>
    </div>
  </div>
</footer>
