---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import WaitlistForm from '../components/WaitlistForm.astro';
import ApprovalQueue from '../components/mockups/ApprovalQueue.astro';
import VolumeBands from '../components/mockups/VolumeBands.astro';
import CheckoutBlock from '../components/mockups/CheckoutBlock.astro';
import QuickOrder from '../components/mockups/QuickOrder.astro';
import MinimumRules from '../components/mockups/MinimumRules.astro';

// Every feature below maps 1:1 to something that exists in the app today.
// Source of truth: docs/app-store-listing-content.md, checked against
// Shopify's own listing validators.
const features = [
  {
    id: 'applications',
    kicker: 'Applications',
    title: 'Approve buyers before they see a single wholesale price.',
    body: 'Buyers apply through a registration form you design. Applications land in a queue where you approve or reject each one. Approved buyers get tagged automatically and see their rates on the next page load.',
    points: ['Form builder, no theme code', 'Approve or reject queue', 'Automatic customer tagging'],
    Mockup: ApprovalQueue,
  },
  {
    id: 'volume',
    kicker: 'Volume pricing',
    title: 'Price by the quantity band, not by the customer.',
    body: 'Set discounts per quantity band and apply them to one product, a whole collection, or the entire store. Mixed variants of the same product add up towards the band, the way a buyer expects.',
    points: ['Unlimited quantity bands', 'Per product, collection or store-wide', 'Mixed variants aggregate'],
    Mockup: VolumeBands,
  },
  {
    id: 'minimums',
    kicker: 'Order minimums',
    title: 'A minimum that actually stops the order.',
    body: 'Require a minimum first order before a buyer becomes a full wholesale account, then keep a recurring minimum after that — by value, by units, or both. Enforced by a Shopify Function at checkout, so a cart permalink cannot walk around it.',
    points: ['First-order qualification', 'Recurring minimums by value or units', 'Enforced at checkout'],
    Mockup: MinimumRules,
  },
  {
    id: 'quick-order',
    kicker: 'Quick order',
    title: 'Let a buyer order 200 units without 40 product pages.',
    body: 'A quick order form on your storefront: type a SKU, set a quantity, repeat. Wholesale buyers already know what they want — this stops making them shop like a retail customer.',
    points: ['Order by SKU', 'Live line totals', 'Drops into any theme as a block'],
    Mockup: QuickOrder,
  },
];

const steps = [
  {
    n: '01',
    title: 'Install and set your baseline',
    body: 'A setup guide walks you through your wholesale discount and who it applies to. Ten minutes, no developer.',
  },
  {
    n: '02',
    title: 'Publish your application form',
    body: 'Drop the registration block into your theme. Buyers apply, you approve, Stockly tags them.',
  },
  {
    n: '03',
    title: 'Set the rules that protect your margin',
    body: 'Quantity bands and order minimums. From here on they are enforced on every order, automatically.',
  },
];

const faqs = [
  {
    q: 'Which Shopify plans does Stockly work on?',
    a: 'Basic, Grow and Advanced. Stockly runs on Shopify Functions, which need an App Store app to work on non-Plus stores — that is exactly what Stockly is. You do not need Shopify Plus.',
  },
  {
    q: 'Is the minimum a warning, or is it actually enforced?',
    a: 'Enforced. It runs as a Shopify Validation Function at checkout. Theme-level banners can be bypassed with a cart permalink; a Validation Function cannot. If a cart is under the minimum, checkout does not complete.',
  },
  {
    q: 'Shopify added native B2B to every plan. Why do I need this?',
    a: "Native B2B gives you company accounts and catalogs, and it is genuinely good. What it does not give you is a minimum order value — there is no native setting for it on any plan, including Plus. It also has no application and approval flow for new buyers, and no quick order form. That gap is what Stockly fills.",
  },
  {
    q: 'How does the discount show up for the buyer?',
    a: 'As a discount at checkout: retail price struck through, wholesale price applied. Rewriting the price so it displays as a clean wholesale figure with no strike-through requires a Shopify Plus feature, so on Basic, Grow and Advanced you will see the discount presentation. The amount the buyer pays is identical either way.',
  },
  {
    q: 'I already have wholesale customers. What happens to them?',
    a: 'You mark them as already qualified during setup, so nobody who has been buying from you for years gets asked for a first order again. Stockly asks you about this on install rather than assuming your store starts from zero.',
  },
  {
    q: 'When can I install it?',
    a: 'Stockly is in review for the Shopify App Store. Join the early access list and you get the install link the day it opens.',
  },
];
---

<Base
  title="Stockly — wholesale for Shopify, enforced at checkout"
  description="Approve B2B buyers, set volume discounts by quantity band, and enforce order minimums at checkout. Wholesale tooling for Shopify stores on Basic, Grow and Advanced."
>
  <Nav />

  <main id="main">
    {/* ---------------------------------------------------------------- Hero */}
    <section class="on-ink bg-ink relative overflow-hidden text-white">
      {/* One soft lime bloom. The brand colour earns its place by being rare. */}
      <div
        class="pointer-events-none absolute -top-40 -right-40 h-[38rem] w-[38rem] rounded-full opacity-[0.13] blur-[110px]"
        style="background: radial-gradient(circle, #c6f23e 0%, transparent 70%)"
        aria-hidden="true"
      >
      </div>

      <div
        class="shell relative grid items-center gap-14 pt-32 pb-20 sm:pt-40 sm:pb-28 lg:grid-cols-[1.15fr_0.85fr] lg:gap-16"
      >
        <div>
          <p class="eyebrow text-lime">
            <span class="bg-lime inline-block h-1.5 w-1.5 rounded-full"></span>
            Wholesale for Shopify
          </p>

          <h1 class="text-display mt-6 font-semibold text-balance">
            Your wholesale rules, enforced at checkout.
          </h1>

          <p class="text-lead mt-6 max-w-xl text-white/60 text-pretty">
            Stockly adds the wholesale layer Shopify leaves out — buyer applications, volume
            discounts by quantity band, and order minimums a buyer cannot walk around.
          </p>

          <div class="mt-10" id="waitlist">
            <WaitlistForm tone="ink" id="hero" />
          </div>
        </div>

        {/* The claim in the headline, shown rather than asserted. */}
        <div class="relative lg:pl-4">
          <div
            class="pointer-events-none absolute -inset-6 rounded-[28px] bg-white/[0.03] ring-1 ring-white/[0.06]"
            aria-hidden="true"
          >
          </div>
          <div class="relative shadow-[0_24px_70px_-20px_rgba(0,0,0,0.7)]">
            <CheckoutBlock />
          </div>
        </div>
      </div>

      {/* Facts, not fake customer logos. Every one is verifiable. */}
      <div class="relative border-t border-white/10">
        <div class="shell grid grid-cols-2 divide-white/10 sm:grid-cols-4 sm:divide-x">
          {
            [
              ['Runs on', 'Shopify Functions'],
              ['Enforced at', 'Checkout, not the cart'],
              ['Works on', 'Basic, Grow, Advanced'],
              ['Free trial', '14 days'],
            ].map(([label, value], i) => (
              <div class={`py-6 ${i % 2 === 1 ? 'pl-5 sm:pl-6' : 'pr-5'} sm:px-6 sm:first:pl-0`}>
                <p class="text-[0.6875rem] font-semibold tracking-wider text-white/55 uppercase">
                  {label}
                </p>
                <p class="mt-1.5 text-[0.9375rem] font-medium text-white/85">{value}</p>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    {/* ----------------------------------------------------------- The gap */}
    <section class="bg-paper-soft section">
      <div class="shell">
        <div class="grid gap-12 lg:grid-cols-[1.05fr_0.95fr] lg:gap-20">
          <div>
            <p class="eyebrow text-muted">The gap</p>
            <h2 class="text-h2 mt-5 font-semibold text-balance">
              Shopify gives you B2B. It doesn't give you rules.
            </h2>
          </div>
          <div class="text-body space-y-5 text-[1.0625rem] leading-relaxed">
            <p>
              Since April 2026 every Shopify plan includes native B2B: company accounts,
              catalogs, per-company pricing. It is a real upgrade and you should use it.
            </p>
            <p>
              What it still cannot do is refuse an order. There is no native setting for a
              minimum order value on any plan — not even Plus. No approval flow for new
              wholesale buyers. No quick order form. So the $40 order from the boutique that
              swore they'd buy in bulk goes through, and you eat the shipping.
            </p>
            <p class="text-ink font-medium">
              Stockly is the enforcement layer. Four things Shopify leaves to you, done properly.
            </p>
          </div>
        </div>
      </div>
    </section>

    {/* --------------------------------------------------------- Features */}
    <section id="features" class="section scroll-mt-8">
      <div class="shell">
        <div class="max-w-2xl">
          <p class="eyebrow text-muted">What's inside</p>
          <h2 class="text-h2 mt-5 font-semibold text-balance">
            Four features. Each one closes a real hole.
          </h2>
        </div>

        <div class="mt-16 space-y-20 sm:mt-20 sm:space-y-28">
          {
            features.map((feature, i) => {
              const { Mockup } = feature;
              const flip = i % 2 === 1;
              return (
                <div
                  id={feature.id}
                  class="grid scroll-mt-24 items-center gap-10 lg:grid-cols-2 lg:gap-16"
                >
                  <div class={flip ? 'lg:order-2' : ''}>
                    <p class="eyebrow text-muted">{feature.kicker}</p>
                    <h3 class="text-h3 mt-4 font-semibold text-balance">{feature.title}</h3>
                    <p class="text-body mt-4 text-[1.0625rem] leading-relaxed">{feature.body}</p>
                    <ul class="mt-6 space-y-2.5">
                      {feature.points.map((point) => (
                        <li class="flex items-start gap-3 text-[0.9375rem]">
                          <span
                            class="bg-lime mt-1.5 inline-block h-1.5 w-1.5 shrink-0 rounded-full"
                            aria-hidden="true"
                          />
                          <span class="text-body">{point}</span>
                        </li>
                      ))}
                    </ul>
                  </div>

                  <div class={flip ? 'lg:order-1' : ''}>
                    <div class="bg-paper-soft rounded-panel p-4 sm:p-7">
                      <Mockup />
                    </div>
                  </div>
                </div>
              );
            })
          }
        </div>
      </div>
    </section>

    {/* ------------------------------------------------------ How it works */}
    <section id="how" class="on-ink bg-ink section scroll-mt-8 text-white">
      <div class="shell">
        <div class="max-w-2xl">
          <p class="eyebrow text-lime">How it works</p>
          <h2 class="text-h2 mt-5 font-semibold text-balance">Live in an afternoon.</h2>
        </div>

        <ol class="mt-14 grid gap-px overflow-hidden rounded-2xl bg-white/10 sm:grid-cols-3">
          {
            steps.map((step) => (
              <li class="bg-ink p-7 sm:p-8">
                <p class="text-lime font-mono text-[0.8125rem]">{step.n}</p>
                <h3 class="mt-4 text-[1.125rem] font-semibold tracking-[-0.02em] text-balance">
                  {step.title}
                </h3>
                <p class="mt-3 text-[0.9375rem] leading-relaxed text-white/55">{step.body}</p>
              </li>
            ))
          }
        </ol>
      </div>
    </section>

    {/* ---------------------------------------------------------- Pricing */}
    <section id="pricing" class="section scroll-mt-8">
      <div class="shell">
        <div class="mx-auto max-w-2xl text-center">
          <p class="eyebrow text-muted">Pricing</p>
          <h2 class="text-h2 mt-5 font-semibold text-balance">One plan. Everything in it.</h2>
          <p class="text-body mt-5 text-[1.0625rem] leading-relaxed">
            No feature gates, no per-order fees, no "contact sales". If Stockly does it, your
            plan includes it.
          </p>
        </div>

        <div class="rounded-panel mx-auto mt-14 max-w-lg bg-white p-8 ring-1 ring-[#e4e4e1] sm:p-10">
          <div class="flex items-baseline justify-between gap-4">
            <div>
              <p class="text-[0.8125rem] font-semibold tracking-wider text-muted uppercase">
                Starter
              </p>
              <p class="mt-3 flex items-baseline gap-1.5">
                <span class="text-5xl font-semibold tracking-[-0.04em]">$39</span>
                <span class="text-muted text-[0.9375rem]">/month</span>
              </p>
            </div>
            <span
              class="bg-lime rounded-full px-3 py-1 text-[0.75rem] font-semibold whitespace-nowrap"
              >14-day free trial</span
            >
          </div>

          <ul class="mt-8 space-y-3.5 border-t border-[#ececea] pt-8">
            {
              [
                'Wholesale application form and approval queue',
                'Automatic customer tagging',
                'Volume discounts by quantity band',
                'First-order and recurring minimums',
                'Quick order form',
                'Email support from the person who built it',
              ].map((item) => (
                <li class="flex items-start gap-3 text-[0.9375rem]">
                  <svg
                    width="17"
                    height="17"
                    viewBox="0 0 17 17"
                    fill="none"
                    class="mt-0.5 shrink-0"
                    aria-hidden="true"
                  >
                    <circle cx="8.5" cy="8.5" r="8.5" fill="#c6f23e" />
                    <path
                      d="M4.9 8.8 7.3 11.2 12 6.2"
                      stroke="#0b0b0b"
                      stroke-width="1.7"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    />
                  </svg>
                  <span class="text-body">{item}</span>
                </li>
              ))
            }
          </ul>

          <div class="mt-8">
            <a href="#final-cta" class="btn btn-ink btn-lg w-full">Get early access</a>
            <p class="text-muted mt-3 text-center text-[0.8125rem]">
              Billed through Shopify. Cancel any time from your admin.
            </p>
          </div>
        </div>
      </div>
    </section>

    {/* -------------------------------------------------------------- FAQ */}
    <section id="faq" class="bg-paper-soft section scroll-mt-8">
      <div class="shell">
        <div class="grid gap-12 lg:grid-cols-[0.8fr_1.2fr] lg:gap-20">
          <div>
            <p class="eyebrow text-muted">FAQ</p>
            <h2 class="text-h2 mt-5 font-semibold text-balance">Straight answers.</h2>
          </div>

          {/* Native <details>. An accordion is not worth a kilobyte of JavaScript. */}
          <div class="divide-y divide-[#dededa] border-y border-[#dededa]">
            {
              faqs.map((faq) => (
                <details class="group">
                  <summary class="flex cursor-pointer list-none items-center justify-between gap-6 py-5 text-left text-[1.0625rem] font-medium">
                    <span class="text-pretty">{faq.q}</span>
                    <span
                      class="relative mt-0.5 h-4 w-4 shrink-0 text-muted"
                      aria-hidden="true"
                    >
                      <span class="absolute top-1/2 left-0 h-px w-4 -translate-y-1/2 bg-current" />
                      <span class="absolute top-1/2 left-0 h-px w-4 -translate-y-1/2 rotate-90 bg-current transition-transform duration-200 group-open:rotate-0" />
                    </span>
                  </summary>
                  <p class="text-body pb-6 text-[0.9375rem] leading-relaxed text-pretty">{faq.a}</p>
                </details>
              ))
            }
          </div>
        </div>
      </div>
    </section>

    {/* --------------------------------------------------------- Final CTA */}
    <section id="final-cta" class="section scroll-mt-8">
      <div class="shell">
        <div
          class="on-ink bg-ink rounded-panel relative overflow-hidden px-7 py-14 text-white sm:px-14 sm:py-20"
        >
          <div
            class="pointer-events-none absolute -right-24 -bottom-32 h-[26rem] w-[26rem] rounded-full opacity-[0.14] blur-[100px]"
            style="background: radial-gradient(circle, #c6f23e 0%, transparent 70%)"
            aria-hidden="true"
          >
          </div>

          <div class="relative max-w-2xl">
            <h2 class="text-h2 font-semibold text-balance">
              Get the install link the day it opens.
            </h2>
            <p class="text-lead mt-5 text-white/60 text-pretty">
              Stockly is in review for the Shopify App Store. Leave your store email and you'll
              be first through the door.
            </p>
            <div class="mt-9">
              <WaitlistForm tone="ink" id="final" />
            </div>
          </div>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Base>
